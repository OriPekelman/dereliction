{
  "name": "dereliction",
  "version": "0.5.0",
  "description": "Give the pixels of a web page mass: GPU particles, rigid words, sand that pours over letters. One script tag, client-side.",
  "main": "lib/dereliction.js",
  "module": "lib/dereliction.mjs",
  "browser": "dist/dereliction.min.js",
  "unpkg": "dist/dereliction.bundle.min.js",
  "jsdelivr": "dist/dereliction.bundle.min.js",
  "exports": {
    ".": { "import": "./lib/dereliction.mjs", "default": "./lib/dereliction.js" },
    "./bundle": "./dist/dereliction.bundle.min.js",
    "./min": "./dist/dereliction.min.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "sideEffects": true,
  "scripts": {
    "build": "npm run build:lib && npm run build:bundle",
    "build:lib": "esbuild lib/dereliction.js --minify --legal-comments=inline --outfile=dist/dereliction.min.js && node -e \"require('fs').copyFileSync('lib/dereliction.js','dist/dereliction.js')\"",
    "build:bundle": "esbuild lib/bundle-entry.js --bundle --minify --legal-comments=inline --format=iife --outfile=dist/dereliction.bundle.min.js",
    "serve": "uv run server.py",
    "test": "uv run python tests/smoke.py",
    "prepack": "npm run build"
  },
  "repository": { "type": "git", "url": "git+https://github.com/OriPekelman/dereliction.git" },
  "homepage": "https://oripekelman.github.io/dereliction/",
  "bugs": { "url": "https://github.com/OriPekelman/dereliction/issues" },
  "keywords": ["webgl", "webgl2", "gpgpu", "particles", "physics", "matter-js", "html2canvas", "creative-coding", "generative", "easter-egg"],
  "author": "Ori Pekelman",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.24.2",
    "html2canvas": "1.4.1",
    "matter-js": "0.20.0"
  },
  "peerDependencies": { "html2canvas": "^1.4.1", "matter-js": "^0.20.0" },
  "peerDependenciesMeta": { "html2canvas": { "optional": true }, "matter-js": { "optional": true } }
}
